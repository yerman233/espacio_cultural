---
import Layout from "../layouts/layout.astro";
import TarjetaTaller from "../components/TarjetaTaller.astro";

const destacados = [
	{
		nombre: "Ilustración",
		descripcion:
			"Desarrollo de habilidades de dibujo e ilustración digital.",
		imagen: "/img/ilustracion.jpg",
	},
	{
		nombre: "Cerámica",
		descripcion:
			"Creación de objetos utilizando técnicas básicas de modelado.",
		imagen: "/img/ceramica.jpg",
	},
	{
		nombre: "Escritura creativa",
		descripcion: "Exploración de relatos breves y ejercicios de escritura.",
		imagen: "/img/escritura.jpg",
	},
];
---

<Layout titulo="Inicio">
	<section class="bienvenida">
		<h1>Bienvenidos a Espacio Cultural</h1>
		<p>
			Un lugar para crear, aprender y compartir. Descubre nuestros
			talleres y actividades abiertas a toda la comunidad.
		</p>
		<a class="boton" href="/talleres">Ver todos los talleres</a>
	</section>


=======


	<section class="presentacion">
		<h2>Quiénes somos</h2>
		<p>
			Somos una organización cultural que impulsa la creatividad a través
			del arte y la palabra, con talleres para distintos niveles en un
			ambiente cercano y colaborativo.
		</p>
	</section>

	<section class="seccion">
		<h2>Talleres destacados</h2>
		<div class="grilla">
			{
				destacados.map((taller) => (
					<TarjetaTaller
						nombre={taller.nombre}
						descripcion={taller.descripcion}
						imagen={taller.imagen}
					/>
				))
			}
		</div>
	</section>
</Layout>
