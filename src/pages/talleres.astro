---
import Layout from "../layouts/layout.astro";
import TarjetaTaller from "../components/TarjetaTaller.astro";

const talleres = [
    {
        nombre: "Fotografía",
        descripcion:
            "Introducción a la composición y técnicas de fotografía digital.",
        imagen: "fotografia.jpg",
    },
    {
        nombre: "Cerámica",
        descripcion:
            "Creación de objetos utilizando técnicas básicas de modelado.",
        imagen: "ceramica.jpg",
    },
    {
        nombre: "Escritura creativa",
        descripcion: "Exploración de relatos breves y ejercicios de escritura.",
        imagen: "escritura.jpg",
    },
    {
        nombre: "Ilustración",
        descripcion:
            "Desarrollo de habilidades de dibujo e ilustración digital.",
        imagen: "ilustracion.jpg",
    },
];
---



=======

<Layout titulo="Talleres">
    <section class="seccion">
        <h1>Nuestros talleres</h1>
        <p class="intro">
            Ofrecemos talleres prácticos pensados para descubrir y desarrollar
            distintas disciplinas artísticas. Elige el que más te inspire.
        </p>
        <div class="grilla">
            {
                talleres.map((taller) => (
                    <TarjetaTaller
                        nombre={taller.nombre}
                        descripcion={taller.descripcion}
                        imagen={taller.imagen}
                    />
                ))
            }
        </div>
    </section>
</Layout>
---

<!doctype html>
<html lang="es">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="stylesheet" href="src/styles/global.css">
        <title>Talleres Creativos</title>
    </head>
    <body>
        <!-- Encabezado de la página -->
        <header>
            <nav>
                <a href="/">inicio</a>
                <a href="/nosotros/">nosotros</a>
                <a href="/talleres/">talleres</a>
            </nav>
            <h1>Talleres</h1>
            <p>
                Aprende nuevas habilidades y explora tu creatividad en un
                entorno interactivo y guiado por profesionales. Conoce nuestra
                oferta académica e inscríbete en el taller de tu interés.
            </p>
        </header>

        <!-- Sección principal con la lista de talleres -->
        <main>
            <section>
                <h2>Listado de Talleres</h2>

                <!-- Tarjeta 1: Fotografía -->
                <article>
                    <h3>Fotografía</h3>
                    <p>
                        Introducción a la composición y técnicas de fotografía
                        digital.
                    </p>
                    <button type="button">Inscribirse</button>
                </article>

                <!-- Tarjeta 2: Cerámica -->
                <article>
                    <h3>Cerámica</h3>
                    <p>
                        Creación de objetos utilizando técnicas básicas de
                        modelado.
                    </p>
                    <button type="button">Inscribirse</button>
                </article>

                <!-- Tarjeta 3: Escritura creativa -->
                <article>
                    <h3>Escritura creativa</h3>
                    <p>
                        Exploración de relatos breves y ejercicios de escritura.
                    </p>
                    <button type="button">Inscribirse</button>
                </article>

                <!-- Tarjeta 4: Ilustración -->
                <article>
                    <h3>Ilustración</h3>
                    <p>
                        Desarrollo de habilidades de dibujo e ilustración
                        digital.
                    </p>
                    <button type="button">Inscribirse</button>
                </article>
            </section>
        </main>

        <!-- Pie de página -->
        <footer>
            <p>
                Desarrollado por <a href="#"
                    >a_geriverosa@colegiosanlorenzo.org</a
                >
                <a href="#">a_benjamincalderon@colegiosanlorenzo.org</a>
            </p>
        </footer>
    </body>
</html>

